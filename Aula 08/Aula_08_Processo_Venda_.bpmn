      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Lane_Estoque" bpmnElement="Lane_Estoque" isHorizontal="true">
        <dc:Bounds x="60" y="900" width="3060" height="400"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Start_Order" bpmnElement="Start_Order">
        <dc:Bounds x="232" y="672" width="36" height="36"/>
