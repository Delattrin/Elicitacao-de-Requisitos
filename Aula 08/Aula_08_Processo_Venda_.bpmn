<?xml version='1.0' encoding='UTF-8'?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_Padaria" targetNamespace="http://bpmn.io/schema/bpmn" exporter="OpenAI" exporterVersion="1.0">
  <bpmn:message id="Message_PaymentRequest" name="Solicitação de pagamento"/>
  <bpmn:message id="Message_PaymentResult" name="Resultado do pagamento"/>
  <bpmn:collaboration id="Collaboration_Padaria">
    <bpmn:participant id="Participant_Padaria" name="Padaria" processRef="Process_Padaria"/>
    <bpmn:participant id="Participant_Payment" name="Operadora de pagamento" processRef="Process_Payment"/>
    <bpmn:messageFlow id="MessageFlow_Request" name="Solicitação de pagamento" sourceRef="Task_RequestPayment" targetRef="Start_PaymentRequest" messageRef="Message_PaymentRequest"/>
    <bpmn:messageFlow id="MessageFlow_Result" name="Resultado do pagamento" sourceRef="Task_SendResult" targetRef="Event_PaymentResult" messageRef="Message_PaymentResult"/>
  </bpmn:collaboration>
  <bpmn:process id="Process_Padaria" name="Processo de venda na padaria" isExecutable="false">
    <bpmn:laneSet id="LaneSet_Padaria">
      <bpmn:lane id="Lane_Caixa" name="Caixa">
        <bpmn:flowNodeRef>Start_Order</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_RegisterItems</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_NotifyCustomer</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Unavailable</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CalculateTotal</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_RequestPayment</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Event_PaymentResult</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_Payment</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_InformDeclined</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Declined</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_ParallelSplit</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_EmitReceipt</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_ParallelJoin</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_DeliverProducts</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_Completed</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Estoque" name="Estoque">
        <bpmn:flowNodeRef>Task_CheckStock</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_Stock</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_RecordUnavailable</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_UpdateStock</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Start_Order" name="Cliente faz pedido"/>
    <bpmn:userTask id="Task_RegisterItems" name="Registrar itens do pedido"/>
    <bpmn:userTask id="Task_CheckStock" name="Conferir disponibilidade dos produtos"/>
    <bpmn:exclusiveGateway id="Gateway_Stock" name="Todos os produtos disponíveis?" gatewayDirection="Diverging"/>
    <bpmn:userTask id="Task_RecordUnavailable" name="Registrar falta de estoque"/>
    <bpmn:userTask id="Task_NotifyCustomer" name="Avisar cliente sobre indisponibilidade"/>
    <bpmn:endEvent id="End_Unavailable" name="Pedido não realizado"/>
    <bpmn:userTask id="Task_CalculateTotal" name="Calcular total da compra"/>
    <bpmn:sendTask id="Task_RequestPayment" name="Solicitar autorização de pagamento" messageRef="Message_PaymentRequest"/>
    <bpmn:intermediateCatchEvent id="Event_PaymentResult" name="Resultado do pagamento recebido">
      <bpmn:messageEventDefinition id="Event_PaymentResult_MessageDefinition" messageRef="Message_PaymentResult"/>
    </bpmn:intermediateCatchEvent>
    <bpmn:exclusiveGateway id="Gateway_Payment" name="Pagamento aprovado?" gatewayDirection="Diverging"/>
    <bpmn:userTask id="Task_InformDeclined" name="Informar pagamento recusado"/>
    <bpmn:endEvent id="End_Declined" name="Venda cancelada"/>
    <bpmn:parallelGateway id="Gateway_ParallelSplit" gatewayDirection="Diverging"/>
    <bpmn:userTask id="Task_EmitReceipt" name="Emitir comprovante da venda"/>
    <bpmn:userTask id="Task_UpdateStock" name="Dar baixa no estoque"/>
    <bpmn:parallelGateway id="Gateway_ParallelJoin" gatewayDirection="Converging"/>
    <bpmn:userTask id="Task_DeliverProducts" name="Entregar produtos ao cliente"/>
    <bpmn:endEvent id="End_Completed" name="Venda concluída"/>
    <bpmn:sequenceFlow id="Flow_Start_Register" sourceRef="Start_Order" targetRef="Task_RegisterItems"/>
    <bpmn:sequenceFlow id="Flow_Register_CheckStock" sourceRef="Task_RegisterItems" targetRef="Task_CheckStock"/>
    <bpmn:sequenceFlow id="Flow_CheckStock_Gateway" sourceRef="Task_CheckStock" targetRef="Gateway_Stock"/>
    <bpmn:sequenceFlow id="Flow_Stock_Yes" sourceRef="Gateway_Stock" targetRef="Task_CalculateTotal" name="Sim"/>
    <bpmn:sequenceFlow id="Flow_Stock_No" sourceRef="Gateway_Stock" targetRef="Task_RecordUnavailable" name="Não"/>
    <bpmn:sequenceFlow id="Flow_Record_Notify" sourceRef="Task_RecordUnavailable" targetRef="Task_NotifyCustomer"/>
    <bpmn:sequenceFlow id="Flow_Notify_EndUnavailable" sourceRef="Task_NotifyCustomer" targetRef="End_Unavailable"/>
    <bpmn:sequenceFlow id="Flow_Calculate_Request" sourceRef="Task_CalculateTotal" targetRef="Task_RequestPayment"/>
    <bpmn:sequenceFlow id="Flow_Request_Result" sourceRef="Task_RequestPayment" targetRef="Event_PaymentResult"/>
    <bpmn:sequenceFlow id="Flow_Result_PaymentGateway" sourceRef="Event_PaymentResult" targetRef="Gateway_Payment"/>
    <bpmn:sequenceFlow id="Flow_Payment_Yes" sourceRef="Gateway_Payment" targetRef="Gateway_ParallelSplit" name="Sim"/>
    <bpmn:sequenceFlow id="Flow_Payment_No" sourceRef="Gateway_Payment" targetRef="Task_InformDeclined" name="Não"/>
    <bpmn:sequenceFlow id="Flow_Declined_End" sourceRef="Task_InformDeclined" targetRef="End_Declined"/>
    <bpmn:sequenceFlow id="Flow_Split_Receipt" sourceRef="Gateway_ParallelSplit" targetRef="Task_EmitReceipt"/>
    <bpmn:sequenceFlow id="Flow_Split_Stock" sourceRef="Gateway_ParallelSplit" targetRef="Task_UpdateStock"/>
    <bpmn:sequenceFlow id="Flow_Receipt_Join" sourceRef="Task_EmitReceipt" targetRef="Gateway_ParallelJoin"/>
    <bpmn:sequenceFlow id="Flow_Stock_Join" sourceRef="Task_UpdateStock" targetRef="Gateway_ParallelJoin"/>
    <bpmn:sequenceFlow id="Flow_Join_Deliver" sourceRef="Gateway_ParallelJoin" targetRef="Task_DeliverProducts"/>
    <bpmn:sequenceFlow id="Flow_Deliver_End" sourceRef="Task_DeliverProducts" targetRef="End_Completed"/>
  </bpmn:process>
  <bpmn:process id="Process_Payment" name="Processo de autorização de pagamento" isExecutable="false">
    <bpmn:startEvent id="Start_PaymentRequest" name="Solicitação de pagamento recebida">
      <bpmn:messageEventDefinition id="Start_PaymentRequest_MessageDefinition" messageRef="Message_PaymentRequest"/>
    </bpmn:startEvent>
    <bpmn:serviceTask id="Task_ValidatePayment" name="Validar dados do pagamento"/>
    <bpmn:sendTask id="Task_SendResult" name="Enviar resultado do pagamento" messageRef="Message_PaymentResult"/>
    <bpmn:endEvent id="End_Payment" name="Resposta enviada"/>
    <bpmn:sequenceFlow id="Flow_PaymentStart_Validate" sourceRef="Start_PaymentRequest" targetRef="Task_ValidatePayment"/>
    <bpmn:sequenceFlow id="Flow_PaymentValidate_Send" sourceRef="Task_ValidatePayment" targetRef="Task_SendResult"/>
    <bpmn:sequenceFlow id="Flow_PaymentSend_End" sourceRef="Task_SendResult" targetRef="End_Payment"/>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_Padaria">
    <bpmndi:BPMNPlane id="BPMNPlane_Padaria" bpmnElement="Collaboration_Padaria">
      <bpmndi:BPMNShape id="Shape_Participant_Payment" bpmnElement="Participant_Payment" isHorizontal="true" isExpanded="true">
        <dc:Bounds x="60" y="120" width="3060" height="290"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Participant_Padaria" bpmnElement="Participant_Padaria" isHorizontal="true" isExpanded="true">
        <dc:Bounds x="60" y="500" width="3060" height="800"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Shape_Lane_Caixa" bpmnElement="Lane_Caixa" isHorizontal="true">
