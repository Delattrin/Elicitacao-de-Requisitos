        <di:waypoint x="1301" y="793"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_Calculate_Request" bpmnElement="Flow_Calculate_Request">
        <di:waypoint x="1005" y="690"/>
        <di:waypoint x="1190" y="690"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_Request_Result" bpmnElement="Flow_Request_Result">
        <di:waypoint x="1360" y="690"/>
        <di:waypoint x="1811" y="690"/>
      </bpmndi:BPMNEdge>
