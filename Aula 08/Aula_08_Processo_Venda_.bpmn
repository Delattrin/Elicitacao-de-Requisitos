        <di:waypoint x="1005" y="793"/>
        <di:waypoint x="1020" y="793"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Edge_Flow_Notify_EndUnavailable" bpmnElement="Flow_Notify_EndUnavailable">
